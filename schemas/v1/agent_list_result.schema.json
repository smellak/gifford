{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/smellak/gifford/schemas/v1/agent_list_result.schema.json",
  "$defs": {
    "AgentEffectiveChannel": {
      "properties": {
        "tx": {
          "type": "boolean"
        },
        "rx": {
          "type": "boolean"
        },
        "auto_delivery": {
          "type": "boolean"
        },
        "auto_continue": {
          "type": "boolean"
        },
        "mode": {
          "type": "string",
          "enum": [
            "FULL",
            "MANUAL",
            "RECEIVE_ONLY",
            "SEND_ONLY",
            "OFF"
          ]
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "tx",
        "rx",
        "auto_delivery",
        "auto_continue"
      ]
    },
    "AgentKeyboardState": {
      "properties": {
        "draft_state": {
          "type": "string",
          "enum": [
            "CLOSED",
            "OPEN",
            "PASTING",
            "SUBMITTING",
            "UNKNOWN"
          ]
        },
        "activity_state": {
          "type": "string",
          "enum": [
            "ACTIVE",
            "PAUSED",
            "IDLE",
            "UNKNOWN"
          ]
        },
        "input_guard_version": {
          "type": "integer",
          "minimum": 0
        },
        "observed_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "draft_state",
        "activity_state",
        "input_guard_version",
        "observed_at"
      ]
    },
    "AgentListItem": {
      "properties": {
        "agent_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
        },
        "node_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
        },
        "harness": {
          "type": "string",
          "enum": [
            "claude-code",
            "codex",
            "muse-code",
            "opencode",
            "antigravity",
            "generic"
          ]
        },
        "harness_version": {
          "type": "string",
          "maxLength": 64,
          "minLength": 1
        },
        "mode": {
          "type": "string",
          "enum": [
            "run",
            "observed"
          ]
        },
        "session_state": {
          "type": "string",
          "enum": [
            "STARTING",
            "CONNECTED",
            "OBSERVED",
            "DETACHED",
            "DISCONNECTED",
            "TERMINATED"
          ]
        },
        "deliverable": {
          "type": "boolean"
        },
        "keyboard": {
          "oneOf": [
            {
              "$ref": "#/$defs/AgentKeyboardState"
            },
            {
              "type": "null"
            }
          ]
        },
        "registered_endpoint": {
          "$ref": "#/$defs/RegisteredEndpointProcess"
        },
        "phase": {
          "$ref": "#/$defs/AgentPhaseStatus"
        },
        "channel": {
          "$ref": "#/$defs/AgentEffectiveChannel"
        },
        "queue": {
          "$ref": "#/$defs/AgentQueueCounts"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "agent_id",
        "node_id",
        "harness",
        "harness_version",
        "mode",
        "session_state",
        "deliverable",
        "keyboard",
        "phase",
        "channel",
        "queue"
      ]
    },
    "AgentPhaseStatus": {
      "properties": {
        "value": {
          "type": "string",
          "enum": [
            "IDLE_AT_PROMPT",
            "THINKING_STREAMING",
            "RUNNING_TOOL",
            "BACKGROUND_WORK",
            "WAITING_APPROVAL",
            "ASKING_QUESTION",
            "ERROR_OR_EXITED",
            "UNKNOWN"
          ]
        },
        "source": {
          "type": "string",
          "enum": [
            "analyst",
            "none"
          ]
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "value",
        "source"
      ]
    },
    "AgentQueueCounts": {
      "properties": {
        "queued": {
          "type": "integer",
          "minimum": 0
        },
        "delivering": {
          "type": "integer",
          "minimum": 0
        },
        "uncertain": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "queued",
        "delivering",
        "uncertain"
      ]
    },
    "RegisteredEndpointProcess": {
      "properties": {
        "pid": {
          "type": "integer",
          "minimum": 1
        },
        "process_start_time": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "pid",
        "process_start_time"
      ]
    }
  },
  "properties": {
    "agents": {
      "items": {
        "$ref": "#/$defs/AgentListItem"
      },
      "type": "array",
      "maxItems": 200
    },
    "next_cursor": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,256}$"
    }
  },
  "additionalProperties": false,
  "type": "object",
  "required": [
    "agents"
  ],
  "title": "AgentListResult"
}
