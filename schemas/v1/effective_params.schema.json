{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/smellak/gifford/schemas/v1/effective_params.schema.json",
  "properties": {
    "from_agent": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
    },
    "to_agent": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
    },
    "plane": {
      "type": "string",
      "enum": [
        "message",
        "artifact",
        "all"
      ]
    }
  },
  "additionalProperties": false,
  "type": "object",
  "required": [
    "from_agent",
    "to_agent",
    "plane"
  ],
  "title": "EffectiveParams"
}
