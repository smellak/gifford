{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/smellak/gifford/schemas/v1/notification_list_params.schema.json",
  "properties": {
    "state": {
      "type": "string",
      "enum": [
        "BASELINED",
        "PENDING",
        "RENDERED"
      ]
    },
    "cursor": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,256}$"
    },
    "limit": {
      "type": "integer",
      "maximum": 200,
      "minimum": 1
    }
  },
  "additionalProperties": false,
  "type": "object",
  "title": "NotificationListParams"
}
