{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/smellak/gifford/schemas/v1/commit_delivery.schema.json",
  "properties": {
    "delivery_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@-]{0,127}$"
    },
    "writer_lease_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@-]{0,127}$"
    }
  },
  "additionalProperties": false,
  "type": "object",
  "required": [
    "delivery_id",
    "writer_lease_id"
  ],
  "title": "CommitDelivery"
}
