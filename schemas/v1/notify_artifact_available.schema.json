{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/smellak/gifford/schemas/v1/notify_artifact_available.schema.json",
  "$defs": {
    "ArtifactRef": {
      "properties": {
        "artifact_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@-]{0,127}$"
        },
        "from_agent": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
        },
        "purpose": {
          "type": "string",
          "maxLength": 200,
          "minLength": 1
        },
        "state": {
          "type": "string",
          "enum": [
            "RESERVED",
            "UPLOADING",
            "STORED_ORIGIN",
            "ROUTING",
            "LOCAL_AVAILABLE",
            "QUEUED_REMOTE",
            "REPLICATING",
            "STORED_REMOTE",
            "AVAILABLE",
            "DOWNLOADING",
            "VERIFYING",
            "DECRYPTED",
            "DELIVERED",
            "ACKNOWLEDGED",
            "FAILED_RETRYABLE",
            "FAILED_PERMANENT",
            "EXPIRED",
            "CANCELLED",
            "REVOKED"
          ]
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "artifact_id",
        "from_agent",
        "purpose",
        "state"
      ]
    }
  },
  "properties": {
    "artifact_ref": {
      "$ref": "#/$defs/ArtifactRef"
    }
  },
  "additionalProperties": false,
  "type": "object",
  "required": [
    "artifact_ref"
  ],
  "title": "NotifyArtifactAvailable"
}
