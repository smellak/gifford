{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/smellak/gifford/schemas/v1/health_report.schema.json",
  "properties": {
    "agent_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
    },
    "health_state": {
      "type": "string",
      "enum": [
        "HEALTHY",
        "DEGRADED",
        "STALLED",
        "CRASHED",
        "DISCONNECTED"
      ]
    },
    "detail": {
      "type": "string",
      "maxLength": 280
    }
  },
  "additionalProperties": false,
  "type": "object",
  "required": [
    "agent_id",
    "health_state"
  ],
  "title": "HealthReport"
}
