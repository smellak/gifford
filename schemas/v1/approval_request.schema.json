{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/smellak/gifford/schemas/v1/approval_request.schema.json",
  "$defs": {
    "ApprovalResolution": {
      "properties": {
        "option": {
          "type": "string",
          "pattern": "^(approve_once|approve_thread:[1-9][0-9]{0,5}[smh]|set_link:allow|reject|extend:\\+[1-9][0-9]{0,5}|set_mode:step|steps:[1-9][0-9]{0,5}|resume|stop|deliver_now|hold)$"
        },
        "reason": {
          "type": "string",
          "maxLength": 280
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "option"
      ]
    }
  },
  "properties": {
    "approval_id": {
      "type": "string",
      "pattern": "^apr_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "source": {
      "type": "string",
      "enum": [
        "link",
        "loop_step",
        "loop_budget",
        "loop_pattern",
        "orchestrator",
        "triage",
        "agent_request"
      ]
    },
    "object_type": {
      "type": "string",
      "enum": [
        "message",
        "artifact",
        "loop",
        "thread_link"
      ]
    },
    "object_id": {
      "type": "string",
      "maxLength": 300,
      "minLength": 1
    },
    "agent_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
    },
    "loop_id": {
      "type": "string",
      "pattern": "^loop_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "options": {
      "items": {
        "type": "string",
        "pattern": "^(approve_once|approve_thread:[1-9][0-9]{0,5}[smh]|set_link:allow|reject|extend:\\+[1-9][0-9]{0,5}|set_mode:step|steps:[1-9][0-9]{0,5}|resume|stop|deliver_now|hold)$"
      },
      "type": "array",
      "maxItems": 8,
      "minItems": 1,
      "uniqueItems": true
    },
    "requested_by": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
    },
    "request_note": {
      "type": "string",
      "maxLength": 500
    },
    "state": {
      "type": "string",
      "enum": [
        "PENDING",
        "APPROVED",
        "REJECTED",
        "EXPIRED",
        "SUPERSEDED"
      ]
    },
    "resolution": {
      "$ref": "#/$defs/ApprovalResolution"
    },
    "resolved_by": {
      "type": "string",
      "maxLength": 128,
      "minLength": 1
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "resolved_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": false,
  "type": "object",
  "required": [
    "approval_id",
    "source",
    "object_type",
    "object_id",
    "options",
    "state",
    "created_at"
  ],
  "title": "ApprovalRequest"
}
