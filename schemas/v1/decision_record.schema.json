{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/smellak/gifford/schemas/v1/decision_record.schema.json",
  "$defs": {
    "EffectiveControl": {
      "properties": {
        "global_mode": {
          "type": "string",
          "enum": [
            "ACTIVE",
            "PAUSED",
            "DRAINING",
            "OFF"
          ]
        },
        "from_node_mode": {
          "type": "string",
          "enum": [
            "ACTIVE",
            "PAUSED",
            "DRAINING",
            "OFF"
          ]
        },
        "to_node_mode": {
          "type": "string",
          "enum": [
            "ACTIVE",
            "PAUSED",
            "DRAINING",
            "OFF"
          ]
        },
        "from_tx": {
          "type": "boolean"
        },
        "from_auto_continue": {
          "type": "boolean"
        },
        "to_rx": {
          "type": "boolean"
        },
        "to_auto_delivery": {
          "type": "boolean"
        },
        "to_deliverable": {
          "type": "boolean"
        },
        "link_mode": {
          "type": "string",
          "enum": [
            "ALLOW",
            "HOLD",
            "REQUIRE_APPROVAL",
            "DENY"
          ]
        },
        "thread_mode": {
          "type": "string",
          "enum": [
            "ALLOW",
            "HOLD",
            "REQUIRE_APPROVAL",
            "DENY"
          ]
        },
        "loop_mode": {
          "type": "string",
          "enum": [
            "AUTO",
            "STEP",
            "PAUSED",
            "DRAINING",
            "STOPPED",
            "COMPLETED"
          ]
        },
        "object_state": {
          "type": "string",
          "enum": [
            "ALLOWED",
            "HELD",
            "APPROVAL_REQUIRED",
            "DENIED"
          ]
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "global_mode",
        "from_node_mode",
        "to_node_mode",
        "from_tx",
        "from_auto_continue",
        "to_rx",
        "to_auto_delivery",
        "to_deliverable",
        "link_mode"
      ]
    },
    "Explanation": {
      "properties": {
        "from_agent": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
        },
        "to_agent": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
        },
        "plane": {
          "type": "string",
          "enum": [
            "message",
            "artifact",
            "all"
          ]
        },
        "object_type": {
          "type": "string",
          "enum": [
            "message",
            "artifact",
            "loop_action"
          ]
        },
        "object_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@-]{0,127}$"
        },
        "thread_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
        },
        "loop_id": {
          "type": "string",
          "pattern": "^loop_[0-9A-HJKMNP-TV-Z]{26}$"
        },
        "loop_generation": {
          "type": "integer",
          "minimum": 1
        },
        "outcome": {
          "type": "string",
          "enum": [
            "ALLOW",
            "HOLD",
            "APPROVAL",
            "DENY"
          ]
        },
        "reason": {
          "type": "string",
          "enum": [
            "ALLOWED",
            "APPROVED_ONCE",
            "APPROVED_THREAD",
            "HOLD_RELEASED",
            "STEP_GRANTED",
            "BUDGET_EXTENDED",
            "CHANNEL_OFF",
            "CHANNEL_PAUSED",
            "CHANNEL_DRAINING",
            "NODE_PAUSED",
            "NODE_OFF",
            "NODE_DRAINING",
            "AGENT_TX_DISABLED",
            "AGENT_RX_DISABLED",
            "AGENT_AUTO_DELIVERY_OFF",
            "AGENT_AUTO_CONTINUE_OFF",
            "LINK_HOLD",
            "LINK_APPROVAL",
            "LINK_DENIED",
            "LOOP_PAUSED",
            "LOOP_STEP_TOKEN_REQUIRED",
            "LOOP_BUDGET_EXHAUSTED",
            "LOOP_PATTERN_DETECTED",
            "LOOP_DRAINING",
            "LOOP_STOPPED",
            "OBJECT_HELD",
            "OBJECT_APPROVAL_PENDING",
            "CONTROL_VERSION_CONFLICT",
            "CONTROL_UNAVAILABLE",
            "CONTROL_CHANGED",
            "POLICY_DENIED"
          ]
        },
        "blocker": {
          "type": "string",
          "enum": [
            "policy",
            "controls",
            "global",
            "node",
            "sender",
            "receiver",
            "link",
            "thread",
            "loop",
            "object"
          ]
        },
        "lines": {
          "items": {
            "$ref": "#/$defs/ExplanationLine"
          },
          "type": "array",
          "maxItems": 12,
          "minItems": 1
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "from_agent",
        "to_agent",
        "plane",
        "outcome",
        "reason",
        "lines"
      ]
    },
    "ExplanationLine": {
      "properties": {
        "scope": {
          "type": "string",
          "enum": [
            "policy",
            "controls",
            "global",
            "node",
            "sender",
            "receiver",
            "link",
            "thread",
            "loop",
            "object"
          ]
        },
        "key": {
          "type": "string",
          "maxLength": 300,
          "minLength": 1
        },
        "value": {
          "type": "string",
          "maxLength": 120,
          "minLength": 1
        },
        "version": {
          "type": "integer",
          "minimum": 0
        },
        "blocking": {
          "type": "boolean"
        },
        "control_id": {
          "type": "string",
          "pattern": "^ctl_[0-9A-HJKMNP-TV-Z]{26}$"
        },
        "actor_type": {
          "type": "string",
          "enum": [
            "human",
            "system",
            "policy",
            "remote_owner"
          ]
        },
        "actor_id": {
          "type": "string",
          "maxLength": 128
        },
        "reason": {
          "type": "string",
          "maxLength": 280
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "scope",
        "key",
        "value"
      ]
    }
  },
  "properties": {
    "decision_id": {
      "type": "string",
      "pattern": "^chd_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "object_type": {
      "type": "string",
      "enum": [
        "message",
        "artifact",
        "loop_action"
      ]
    },
    "object_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@-]{0,127}$"
    },
    "stage": {
      "type": "string",
      "enum": [
        "admission",
        "acceptance",
        "delivery",
        "continuation",
        "revalidation"
      ]
    },
    "plane": {
      "type": "string",
      "enum": [
        "message",
        "artifact",
        "all"
      ]
    },
    "from_agent": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
    },
    "to_agent": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
    },
    "outcome": {
      "type": "string",
      "enum": [
        "ALLOW",
        "HOLD",
        "APPROVAL",
        "DENY"
      ]
    },
    "reason": {
      "type": "string",
      "enum": [
        "ALLOWED",
        "APPROVED_ONCE",
        "APPROVED_THREAD",
        "HOLD_RELEASED",
        "STEP_GRANTED",
        "BUDGET_EXTENDED",
        "CHANNEL_OFF",
        "CHANNEL_PAUSED",
        "CHANNEL_DRAINING",
        "NODE_PAUSED",
        "NODE_OFF",
        "NODE_DRAINING",
        "AGENT_TX_DISABLED",
        "AGENT_RX_DISABLED",
        "AGENT_AUTO_DELIVERY_OFF",
        "AGENT_AUTO_CONTINUE_OFF",
        "LINK_HOLD",
        "LINK_APPROVAL",
        "LINK_DENIED",
        "LOOP_PAUSED",
        "LOOP_STEP_TOKEN_REQUIRED",
        "LOOP_BUDGET_EXHAUSTED",
        "LOOP_PATTERN_DETECTED",
        "LOOP_DRAINING",
        "LOOP_STOPPED",
        "OBJECT_HELD",
        "OBJECT_APPROVAL_PENDING",
        "CONTROL_VERSION_CONFLICT",
        "CONTROL_UNAVAILABLE",
        "CONTROL_CHANGED",
        "POLICY_DENIED"
      ]
    },
    "matched_control_ids": {
      "items": {
        "type": "string",
        "pattern": "^ctl_[0-9A-HJKMNP-TV-Z]{26}$"
      },
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true
    },
    "effective_control": {
      "$ref": "#/$defs/EffectiveControl"
    },
    "control_versions": {
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      },
      "propertyNames": {
        "maxLength": 200,
        "minLength": 1
      },
      "type": "object",
      "maxProperties": 64
    },
    "explanation": {
      "$ref": "#/$defs/Explanation"
    },
    "actor_id": {
      "type": "string",
      "maxLength": 128
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": false,
  "type": "object",
  "required": [
    "decision_id",
    "object_type",
    "object_id",
    "stage",
    "plane",
    "outcome",
    "reason",
    "matched_control_ids",
    "effective_control",
    "control_versions",
    "explanation",
    "created_at"
  ],
  "title": "DecisionRecord"
}
