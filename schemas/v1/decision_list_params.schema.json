{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/smellak/gifford/schemas/v1/decision_list_params.schema.json",
  "properties": {
    "agent_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
    },
    "message_id": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "type": {
      "type": "string",
      "enum": [
        "channel",
        "orchestrator"
      ]
    },
    "cursor": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,256}$"
    },
    "limit": {
      "type": "integer",
      "maximum": 200,
      "minimum": 1
    }
  },
  "additionalProperties": false,
  "type": "object",
  "title": "DecisionListParams"
}
