{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/smellak/gifford/schemas/v1/set_agent_channel_params.schema.json",
  "properties": {
    "agent_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
    },
    "tx": {
      "type": "boolean"
    },
    "rx": {
      "type": "boolean"
    },
    "auto_delivery": {
      "type": "boolean"
    },
    "auto_continue": {
      "type": "boolean"
    },
    "ttl_ms": {
      "type": "integer",
      "maximum": 2592000000,
      "minimum": 0
    },
    "reason": {
      "type": "string",
      "maxLength": 280
    },
    "expected_version": {
      "type": "integer",
      "minimum": 0
    }
  },
  "additionalProperties": false,
  "type": "object",
  "required": [
    "agent_id",
    "expected_version"
  ],
  "title": "SetAgentChannelParams"
}
