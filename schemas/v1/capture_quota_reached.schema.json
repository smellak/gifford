{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/smellak/gifford/schemas/v1/capture_quota_reached.schema.json",
  "properties": {
    "capture_session_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@-]{0,127}$"
    },
    "quota_scope": {
      "type": "string",
      "enum": [
        "node",
        "agent"
      ]
    },
    "bytes": {
      "type": "integer",
      "minimum": 0
    },
    "limit_bytes": {
      "type": "integer",
      "minimum": 1
    }
  },
  "additionalProperties": false,
  "type": "object",
  "required": [
    "capture_session_id",
    "quota_scope",
    "bytes",
    "limit_bytes"
  ],
  "title": "CaptureQuotaReached"
}
