{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/smellak/gifford/schemas/v1/capture_resize.schema.json",
  "properties": {
    "capture_session_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@-]{0,127}$"
    },
    "cols": {
      "type": "integer",
      "maximum": 10000,
      "minimum": 1
    },
    "rows": {
      "type": "integer",
      "maximum": 10000,
      "minimum": 1
    }
  },
  "additionalProperties": false,
  "type": "object",
  "required": [
    "capture_session_id",
    "cols",
    "rows"
  ],
  "title": "CaptureResize"
}
