{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/smellak/gifford/schemas/v1/capture_chunk.schema.json",
  "properties": {
    "capture_session_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@-]{0,127}$"
    },
    "byte_count": {
      "type": "integer",
      "maximum": 1048576,
      "minimum": 1
    },
    "ansi_present": {
      "type": "boolean"
    },
    "raw_blob_ref": {
      "type": "string",
      "pattern": "^blob://[A-Za-z0-9._/-]{1,256}$"
    }
  },
  "additionalProperties": false,
  "type": "object",
  "required": [
    "capture_session_id",
    "byte_count",
    "ansi_present",
    "raw_blob_ref"
  ],
  "title": "CaptureChunk"
}
