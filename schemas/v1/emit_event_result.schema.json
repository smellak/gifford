{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/smellak/gifford/schemas/v1/emit_event_result.schema.json",
  "properties": {
    "event_id": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "status": {
      "type": "string",
      "enum": [
        "STORED",
        "ALREADY_STORED",
        "REJECTED"
      ]
    },
    "reason": {
      "type": "string",
      "enum": [
        "NOT_ALLOWED",
        "CONFLICT"
      ]
    }
  },
  "additionalProperties": false,
  "type": "object",
  "required": [
    "event_id",
    "status"
  ],
  "title": "EmitEventResult"
}
