{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/smellak/gifford/schemas/v1/capture_gap_detected.schema.json",
  "properties": {
    "capture_session_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@-]{0,127}$"
    },
    "cause": {
      "type": "string",
      "enum": [
        "pipe_closed",
        "ingest_died",
        "quota"
      ]
    }
  },
  "additionalProperties": false,
  "type": "object",
  "required": [
    "capture_session_id",
    "cause"
  ],
  "title": "CaptureGapDetected"
}
