{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/smellak/gifford/schemas/v1/register_agent_result.schema.json",
  "properties": {
    "agent_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
    },
    "session_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@-]{0,127}$"
    }
  },
  "additionalProperties": false,
  "type": "object",
  "required": [
    "agent_id",
    "session_id"
  ],
  "title": "RegisterAgentResult"
}
