{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/smellak/gifford/schemas/v1/message_ack_report.schema.json",
  "properties": {
    "agent_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
    },
    "message_id": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "status": {
      "type": "string",
      "enum": [
        "PROCESSING",
        "ACKNOWLEDGED"
      ]
    }
  },
  "additionalProperties": false,
  "type": "object",
  "required": [
    "agent_id",
    "message_id",
    "status"
  ],
  "title": "MessageAckReport"
}
